#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uSrcTex;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outDstTex;

layout(push_constant) uniform BloomDownPC {
    vec4 params; // x: threshold, y: knee, z: isFirstMip (1.0 or 0.0), w: unused
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 karisSample(vec3 c) {
    return c / (1.0 + luminance(c));
}

vec3 softThreshold(vec3 c, float threshold, float knee) {
    float br = max(c.r, max(c.g, c.b));
    float rq = clamp(br - threshold + knee, 0.0, 2.0 * knee);
    rq = (rq * rq) / max(4.0 * knee, 1e-5);
    float weight = max(rq, br - threshold) / max(br, 1e-5);
    return c * max(weight, 0.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(outDstTex);
    if (gid.x >= dstSize.x || gid.y >= dstSize.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(dstSize);
    vec2 srcTexel = 1.0 / vec2(textureSize(uSrcTex, 0));

    // 13-tap Call of Duty downsample kernel
    vec3 a = texture(uSrcTex, uv + vec2(-2.0,  2.0) * srcTexel).rgb;
    vec3 b = texture(uSrcTex, uv + vec2( 0.0,  2.0) * srcTexel).rgb;
    vec3 c = texture(uSrcTex, uv + vec2( 2.0,  2.0) * srcTexel).rgb;

    vec3 d = texture(uSrcTex, uv + vec2(-2.0,  0.0) * srcTexel).rgb;
    vec3 e = texture(uSrcTex, uv).rgb;
    vec3 f = texture(uSrcTex, uv + vec2( 2.0,  0.0) * srcTexel).rgb;

    vec3 g = texture(uSrcTex, uv + vec2(-2.0, -2.0) * srcTexel).rgb;
    vec3 h = texture(uSrcTex, uv + vec2( 0.0, -2.0) * srcTexel).rgb;
    vec3 i = texture(uSrcTex, uv + vec2( 2.0, -2.0) * srcTexel).rgb;

    vec3 j = texture(uSrcTex, uv + vec2(-1.0,  1.0) * srcTexel).rgb;
    vec3 k = texture(uSrcTex, uv + vec2( 1.0,  1.0) * srcTexel).rgb;
    vec3 l = texture(uSrcTex, uv + vec2(-1.0, -1.0) * srcTexel).rgb;
    vec3 m = texture(uSrcTex, uv + vec2( 1.0, -1.0) * srcTexel).rgb;

    vec3 result;
    if (pc.params.z > 0.5) {
        vec3 g0 = karisSample((a + b + d + e) * 0.25);
        vec3 g1 = karisSample((b + c + e + f) * 0.25);
        vec3 g2 = karisSample((d + e + g + h) * 0.25);
        vec3 g3 = karisSample((e + f + h + i) * 0.25);
        vec3 g4 = karisSample((j + k + l + m) * 0.25);
        result = g0 * 0.125 + g1 * 0.125 + g2 * 0.125 + g3 * 0.125 + g4 * 0.5;
        result = softThreshold(result, pc.params.x, pc.params.y);
    } else {
        result = e * 0.125;
        result += (a + c + g + i) * 0.03125;
        result += (b + d + f + h) * 0.0625;
        result += (j + k + l + m) * 0.125;
    }

    imageStore(outDstTex, gid, vec4(max(result, vec3(0.0)), 1.0));
}
