#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uBaseMip;
layout(set = 0, binding = 1) uniform sampler2D uSmallMip;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outUpsampled;

layout(push_constant) uniform BloomUpPC {
    vec4 params; // x: filterRadius, y: smallWeight, z: baseWeight
} pc;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(outUpsampled);
    if (gid.x >= dstSize.x || gid.y >= dstSize.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(dstSize);
    vec2 texel = 1.0 / vec2(textureSize(uSmallMip, 0)) * pc.params.x;

    // 9-tap tent filter
    vec3 s = vec3(0.0);
    s += texture(uSmallMip, uv + vec2(-texel.x,  texel.y)).rgb * 1.0;
    s += texture(uSmallMip, uv + vec2( 0.0,      texel.y)).rgb * 2.0;
    s += texture(uSmallMip, uv + vec2( texel.x,  texel.y)).rgb * 1.0;

    s += texture(uSmallMip, uv + vec2(-texel.x,  0.0)).rgb * 2.0;
    s += texture(uSmallMip, uv).rgb * 4.0;
    s += texture(uSmallMip, uv + vec2( texel.x,  0.0)).rgb * 2.0;

    s += texture(uSmallMip, uv + vec2(-texel.x, -texel.y)).rgb * 1.0;
    s += texture(uSmallMip, uv + vec2( 0.0,     -texel.y)).rgb * 2.0;
    s += texture(uSmallMip, uv + vec2( texel.x, -texel.y)).rgb * 1.0;
    s *= (1.0 / 16.0);

    vec3 base = texture(uBaseMip, uv).rgb;
    vec3 combined = base * pc.params.z + s * pc.params.y;
    imageStore(outUpsampled, gid, vec4(max(combined, vec3(0.0)), 1.0));
}
