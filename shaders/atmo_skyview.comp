#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uTransmittanceLUT;
layout(set = 0, binding = 1) uniform sampler2D uMultiScatterLUT;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outSkyView;

layout(push_constant) uniform AtmoPC {
    vec4 sunDirTurbidity;   // xyz: trueSunDir, w: turbidity
    vec4 sunColorAnisotropy;// rgb: sunColor/irradiance, w: mieG
} pc;

const float PI = 3.14159265359;
const float R_PLANET = 6360.0;
const float R_ATMO   = 6460.0;

const vec3 RAYLEIGH_SCATTER = vec3(5.802e-3, 13.558e-3, 33.100e-3);
const float MIE_SCATTER     = 3.996e-3;
const float MIE_ABSORB      = 4.400e-3;
const vec3 OZONE_ABSORB     = vec3(0.650e-3, 1.881e-3, 0.085e-3);

vec2 transmittanceUV(float r, float cosTheta) {
    float H = sqrt(max(0.0, R_ATMO * R_ATMO - R_PLANET * R_PLANET));
    float rho = sqrt(max(0.0, r * r - R_PLANET * R_PLANET));
    float disc = r * r * (cosTheta * cosTheta - 1.0) + R_ATMO * R_ATMO;
    float d = max(0.0, -r * cosTheta + sqrt(max(0.0, disc)));
    float dMin = R_ATMO - r;
    float dMax = rho + H;
    float xMu = clamp((d - dMin) / max(dMax - dMin, 1e-5), 0.0, 1.0);
    float xR = clamp(rho / max(H, 1e-5), 0.0, 1.0);
    return vec2(xMu, xR);
}

bool hitSphere(vec3 ro, vec3 rd, float rad, out float tOut) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - rad * rad;
    float disc = b * b - c;
    if (disc < 0.0) { tOut = -1.0; return false; }
    float s = sqrt(disc);
    float t0 = -b - s;
    float t1 = -b + s;
    if (t1 < 0.0) { tOut = -1.0; return false; }
    tOut = (t0 >= 0.0) ? t0 : t1;
    return true;
}

float rayleighPhase(float cosTheta) {
    return (3.0 / (16.0 * PI)) * (1.0 + cosTheta * cosTheta);
}

float hgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outSkyView);
    if (gid.x >= size.x || gid.y >= size.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(size);

    float azimuth = (uv.x - 0.5) * 2.0 * PI;
    float v = uv.y;
    float adjV = (v < 0.5) ? -pow(1.0 - 2.0 * v, 2.0) : pow(2.0 * v - 1.0, 2.0);
    float elevation = adjV * (PI * 0.5);

    float cosEl = cos(elevation);
    vec3 rd = normalize(vec3(cosEl * cos(azimuth), sin(elevation), cosEl * sin(azimuth)));
    vec3 ro = vec3(0.0, R_PLANET + 0.25, 0.0);

    vec3 sunDir = normalize(pc.sunDirTurbidity.xyz);
    float turbidity = max(pc.sunDirTurbidity.w, 0.2);
    float mieG = clamp(pc.sunColorAnisotropy.w, 0.1, 0.95);
    vec3 sunIrradiance = pc.sunColorAnisotropy.rgb;

    float tPlanet = -1.0;
    float tAtmo = -1.0;
    bool hitPlanet = hitSphere(ro, rd, R_PLANET, tPlanet);
    hitSphere(ro, rd, R_ATMO, tAtmo);
    float maxDist = hitPlanet ? min(tPlanet, tAtmo) : tAtmo;

    const int STEPS = 32;
    float stepLen = maxDist / float(STEPS);

    float cosTheta = dot(rd, sunDir);
    float pRay = rayleighPhase(cosTheta);
    float pMie = hgPhase(cosTheta, mieG);

    vec3 L = vec3(0.0);
    vec3 throughput = vec3(1.0);

    for (int i = 0; i < STEPS; ++i) {
        float t = (float(i) + 0.5) * stepLen;
        vec3 p = ro + rd * t;
        float r = length(p);
        float h = max(r - R_PLANET, 0.0);
        vec3 up = p / r;

        float rDens = exp(-h / 8.0);
        float mDens = exp(-h / 1.2) * turbidity;
        float oDens = max(0.0, 1.0 - abs(h - 25.0) / 15.0);

        vec3 rayScatter = RAYLEIGH_SCATTER * rDens;
        float mieScatter = MIE_SCATTER * mDens;
        vec3 extinct = rayScatter + vec3((MIE_SCATTER + MIE_ABSORB) * mDens) + OZONE_ABSORB * oDens;

        vec3 stepTrans = exp(-extinct * stepLen);

        float sunCos = dot(up, sunDir);
        vec3 sunTrans = texture(uTransmittanceLUT, transmittanceUV(r, sunCos)).rgb;

        float sunVis = smoothstep(-0.10, 0.06, sunCos);
        vec3 singleScatter = sunVis * (sunTrans * (rayScatter * pRay + vec3(mieScatter * pMie)));

        vec2 msUV = vec2(sunCos * 0.5 + 0.5, clamp(h / (R_ATMO - R_PLANET), 0.0, 1.0));
        vec3 multiScatter = texture(uMultiScatterLUT, msUV).rgb * (rayScatter + vec3(mieScatter)) * smoothstep(-0.14, 0.06, sunCos);

        vec3 inScatter = (singleScatter + multiScatter) * sunIrradiance;
        vec3 safeExt = max(extinct, vec3(1e-6));
        L += throughput * (inScatter - inScatter * stepTrans) / safeExt;
        throughput *= stepTrans;
    }

    // Subtle night sky airglow when sun is below horizon
    float nightBlend = smoothstep(0.06, -0.22, sunDir.y);
    vec3 nightGlow = mix(vec3(0.012, 0.020, 0.042), vec3(0.004, 0.007, 0.018), clamp(rd.y * 0.8 + 0.2, 0.0, 1.0));
    L += nightGlow * nightBlend;

    imageStore(outSkyView, gid, vec4(max(L, vec3(0.0)), 1.0));
}

