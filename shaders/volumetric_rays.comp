#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer GodRaysBuffer {
    mat4 invViewProj;
    mat4 lightSpaceMatrices[4];
    vec4 cameraPos;      // xyz, w: cascadeSplits.x
    vec4 sunDir;         // xyz, w: cascadeSplits.y
    vec4 sunColor;       // rgb, w: sunIntensity
    vec4 params0;        // x: cascadeSplits.z, y: cascadeSplits.w, z: frameIndex, w: enabled
    vec4 params1;        // x: maxDist, y: scatteringDensity, z: anisotropy, w: waterLevel
} godRays;

layout(set = 0, binding = 1) uniform sampler2D uDepthTex;
layout(set = 0, binding = 2) uniform sampler2D uShadowAtlas;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outGodRays;

float interleavedGradientNoise(vec2 pos) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(pos, magic.xy)));
}

vec3 reconstructWorldPos(vec2 uv, float depth) {
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 wp = godRays.invViewProj * vec4(ndc, depth, 1.0);
    return wp.xyz / max(wp.w, 1e-5);
}

float sampleShadow(vec3 worldPos, float distFromCam) {
    vec4 splits = vec4(godRays.cameraPos.w, godRays.sunDir.w, godRays.params0.x, godRays.params0.y);
    int cascade = 3;
    if (distFromCam < splits.x) cascade = 0;
    else if (distFromCam < splits.y) cascade = 1;
    else if (distFromCam < splits.z) cascade = 2;

    vec4 ls = godRays.lightSpaceMatrices[cascade] * vec4(worldPos, 1.0);
    vec3 proj = ls.xyz / ls.w;
    vec2 tileUV = proj.xy * 0.5 + 0.5;
    if (any(lessThan(tileUV, vec2(0.01))) || any(greaterThan(tileUV, vec2(0.99))) || proj.z > 1.0) {
        return 1.0;
    }

    vec2 tileOffset = vec2(float(cascade % 2), float(cascade / 2)) * 0.5;
    vec2 atlasUV = tileOffset + tileUV * 0.5;
    float d = texture(uShadowAtlas, atlasUV).r;
    return (proj.z - 0.003 <= d) ? 1.0 : 0.0;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outGodRays);
    if (gid.x >= size.x || gid.y >= size.y) return;

    if (godRays.params0.w < 0.5 || godRays.sunDir.y <= 0.01) {
        imageStore(outGodRays, gid, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(gid) + 0.5) / vec2(size);
    float depth = texture(uDepthTex, uv).r;

    vec3 camPos = godRays.cameraPos.xyz;
    vec3 farPos = reconstructWorldPos(uv, min(depth, 0.9999));
    vec3 rayVec = farPos - camPos;
    float sceneDist = length(rayVec);
    vec3 rayDir = rayVec / max(sceneDist, 1e-4);

    float maxDist = godRays.params1.x;
    float marchDist = (depth >= 0.9999) ? maxDist : min(sceneDist, maxDist);

    const int STEPS = 16;
    float stepSize = marchDist / float(STEPS);
    float jitter = interleavedGradientNoise(vec2(gid) + godRays.params0.z * 5.71);

    float cosTheta = dot(rayDir, normalize(godRays.sunDir.xyz));
    float g = godRays.params1.z;
    float g2 = g * g;
    float phase = (1.0 - g2) / (4.0 * 3.14159265 * pow(max(1.0 + g2 - 2.0 * g * cosTheta, 0.05), 1.5));

    float density = godRays.params1.y;
    float waterLevel = godRays.params1.w;
    float accum = 0.0;

    for (int i = 0; i < STEPS; ++i) {
        float t = (float(i) + jitter) * stepSize;
        vec3 p = camPos + rayDir * t;
        float sh = sampleShadow(p, t);
        float heightFade = exp(-max(p.y - (waterLevel + 4.0), 0.0) * 0.020);
        accum += sh * heightFade * density * stepSize;
    }

    vec3 light = godRays.sunColor.rgb * godRays.sunColor.w * phase * accum;
    imageStore(outGodRays, gid, vec4(min(light, vec3(2.5)), 1.0));
}
